    {
      "parameters": {
        "jsCode": "const incoming = $input.first().json;\nconst body = incoming.body ?? incoming;\nconst email = typeof body.email === 'string' ? body.email.trim().toLowerCase() : '';\nconst requestId = typeof body.request_id === 'string' ? body.request_id.trim() : '';\nconst errors = [];\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || email.length > 254) errors.push('invalid email');\nif (!/^[A-Za-z0-9_-]{1,64}$/.test(requestId)) errors.push('invalid request_id');\nreturn [{json: errors.length ? {ok:false, errors, request_id: requestId || null} : {ok:true, request_id:requestId, email, status:'validated'}}];"
      },
      "id": "e959c190-1c39-4f4d-a383-fae283db1930",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
